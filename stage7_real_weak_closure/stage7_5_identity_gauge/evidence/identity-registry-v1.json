    {
      "object_id": "alpha",
      "name": "场景标定尺度系数",
      "identity_class": "N_t",
      "unit": "dimensionless",
      "shape": "scalar",
      "spatial_support": "per_acquisition_footprint",
      "temporal_support": "per_acquisition",
      "granularity": "acquisition_x_band",
      "granularity_note": "每个 acquisition 的每个波段各持一个独立 alpha。自由度计数按此粒度展开：18 景 × 2 波段 = 36 个实例，不得按景聚合为 18。依据 estimator.fitting_key = 'acquisition x band'。",
      "observation_status": "latent",
      "availability": "train_and_inference",
      "anchor": null,
      "prior": null,
      "normalization": "clip(·, 0, 1)",
      "gauge": {
        "fixed": true,
        "rule": "当前模型把全部乘性尺度因素——大气透过率、太阳辐照度常数、场景平均反照率——合并为单一参数，等价于将其余各因素隐式固定为 1。",
        "rationale": "模型形式 rho_hat = alpha * mu 中不存在独立的透过率或辐照度项，因此 alpha 的数值是该合成量的估计，不是任一单项物理量的测量。"
      },
      "allowed_paths": [
        "L2_forward_synthesis_multiplicative_scale"
      ],
      "forbidden_paths": [
        "被报告为地表反照率的独立估计",
        "被报告为大气透过率的独立估计",
        "跨 acquisition 或跨 band 共用同一实例"
      ],
      "disposition": "identity_qualified_with_fixed_gauge",
      "evidence_scope": "global",
      "global_justification_kind": "analytic_proof",
      "evidence_scope_justification": "结论来自解析论证而非数值实验：模型对 alpha 线性，Jacobian 各元素为 mu 且不随参数点变化，故局部结论在整个参数域成立。这是 evidence_scope=global 的合法来源（解析/结构证明），不是多起点数值实验的升级。",
