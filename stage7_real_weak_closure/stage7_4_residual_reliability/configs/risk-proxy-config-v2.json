   "band",
   "fold",
   "curve_scope"
  ],
  "within_acquisition_band_scope": [
   "fold_median",
   "fold_range"
  ],
  "across_acquisitions": {
   "weight": "equal_per_acquisition",
   "statistics": [
    "median",
    "range"
   ]
  },
  "categorical_key": [
   "band",
   "curve_scope",
   "risk_proxy_verdict"
  ],
  "retain_not_evaluable_reason_counts": true,
  "pass_fail_collapse": false,
  "pixel_pooling_as_unit_replacement": false,
  "ranking": false,
  "effective_n_p_value_confidence_interval_or_significance": false
 },
