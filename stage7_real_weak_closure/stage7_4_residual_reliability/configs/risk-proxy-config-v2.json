   "protocol_error",
   "insufficient_scored_support",
   "score_degenerate",
   "curve_shape",
   "risk_proxy_verdict_mapping"
  ],
  "verdict_point_sequence": "coverage_ordered_canonical_reachable_5pct_points",
  "delta_predicates": {
   "positive": "delta>tau_outcome",
   "zero": "abs(delta)<=tau_outcome",
   "negative": "delta<-tau_outcome"
  },
  "curve_shape_closed_set": [
   "flat",
   "order_consistent",
   "order_inverted",
   "mixed"
  ],
  "risk_proxy_verdict_closed_set": [
   "not_evaluable_insufficient_scored_support",
   "not_evaluable_score_degenerate",
   "descriptive_ordering_signal",
   "directionally_adverse",
   "descriptive_non_discriminative"
  ],
  "mapping": {
   "order_consistent": "descriptive_ordering_signal",
   "order_inverted": "directionally_adverse",
   "flat": "descriptive_non_discriminative",
   "mixed": "descriptive_non_discriminative"
  },
  "mixed_claim": "no_consistent_direction_only",
  "not_evaluable_reason_closed_set": {
   "not_evaluable_insufficient_scored_support": [
    "unit_gate_not_scored",
    "zero_base_valid_land_denominator",
    "zero_scored_denominator",
    "N_scored_below_271"
   ],
   "not_evaluable_score_degenerate": [
    "score_range_at_or_below_tau_score",
    "unique_proxy_values_below_3",
    "admissible_exact_points_below_3",
    "canonical_reachable_grid_points_below_3",
    "AURC_nonpositive_span"
   ]
  },
  "retain_curve_shape_and_not_evaluable_reason": true,
  "synthetic_unit_or_node_verdict": false
 },
 "aggregation": {
  "continuous_base_key": [
